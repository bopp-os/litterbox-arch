# Maintainer: BoppOS Team
pkgname=litterbox-sandbox
pkgver=0.6.5
pkgrel=2
pkgdesc="Somewhat isolated Podman development environments with a confirm-before-sign SSH agent"
arch=('x86_64')
url="https://litterbox.work"
license=('Apache-2.0')
depends=('coreutils' 'gcc-libs' 'glibc' 'podman')
makedepends=('rust' 'rust-musl')
options=('!debug')
# The SSH confirmation pop-up (egui) dlopen()s these at runtime, so they are not linked
optdepends=(
  'sudo: device passthrough (litterbox device)'
  'wayland: SSH confirmation pop-up on Wayland'
  'libxkbcommon: pop-up keyboard input'
  'libx11: SSH confirmation pop-up on X11'
  'libxcb: SSH confirmation pop-up on X11'
  'libxcursor: SSH confirmation pop-up on X11'
  'libxi: SSH confirmation pop-up on X11'
  'libxkbcommon-x11: pop-up keyboard input on X11'
  'libglvnd: pop-up rendering via EGL'
  'vulkan-icd-loader: pop-up rendering via Vulkan'
)
conflicts=('litterbox')
# The tarball must stay first: tools/update-litterbox rewrites only the first checksum on the sha256sums= line.
source=("$pkgname-$pkgver.tar.gz::https://github.com/Gerharddc/litterbox/archive/refs/tags/v$pkgver.tar.gz"
        litterbox-stable-wayland-socket.patch
        litterbox-cachyos-cpu-variants.patch
        litterbox-russh-0.64.1.patch)
sha256sums=('529ce2c0b9ce1fe617b1b36d343118b095a19cc242f997ab4d9fc924f086cd4b'
            'd5e249cb52a3dcf614c11413defe009dd14269118ae9f600e19be3cda8f8779a'
            '64d41d4b9d7158dc004def7cc0f8824c6539beec90da929f31ddef6166b5d560'
            '4a5d75be7b98f601914c63b08b5d115cf52df3941a519c598e2daaef17eadcb6')

_musl=x86_64-unknown-linux-musl

prepare() {
  cd "Litterbox-$pkgver"
  # litterbox-stable-wayland-socket: the container's Wayland mount points at a stable per-Litterbox link that is
  #   refreshed whenever the container starts, so a changed wayland-N name no longer breaks it.
  # litterbox-cachyos-cpu-variants: x86-64-v4 and znver4 (ghcr.io/bopp-os/cachyos-docker) CachyOS templates.
  # litterbox-russh-0.64.1: russh agent-server fix (GHSA-4wc5-f2rc-q74m); drop once upstream ships russh >= 0.64.1.
  # A patch that no longer applies to a new upstream release fails the build, which holds the update back.
  local p
  for p in litterbox-stable-wayland-socket litterbox-cachyos-cpu-variants litterbox-russh-0.64.1; do
    patch -Np1 -i "$srcdir/$p.patch"
  done
  local host; host="$(rustc -vV | sed -n 's/host: //p')"
  (cd litterbox && cargo fetch --locked --target "$host")
  (cd lbx-init  && cargo fetch --locked --target "$_musl")
}

build() {
  cd "Litterbox-$pkgver"
  (cd litterbox && cargo build --frozen --release)
  # lbx-init is bind-mounted into arbitrary container images, so it must be static
  (cd lbx-init  && cargo build --frozen --release --target "$_musl")
}

check() {
  cd "Litterbox-$pkgver"
  (cd litterbox && cargo test --frozen)
  (cd lbx-init  && cargo test --frozen --target "$_musl")
}

package() {
  cd "Litterbox-$pkgver"
  # Both crates build into their own target/ directory, unless CARGO_TARGET_DIR points them at one shared directory (the
  # pkgbuilds CI does that to keep a build cache between runs).
  local lbx_bin="${CARGO_TARGET_DIR:-litterbox/target}/release/litterbox"
  local init_bin="${CARGO_TARGET_DIR:-lbx-init/target}/$_musl/release/lbx-init"
  # litterbox locates lbx-init next to its own executable, so both go in /usr/bin
  install -Dm755 "$lbx_bin" "$pkgdir/usr/bin/litterbox"
  install -Dm755 "$init_bin" "$pkgdir/usr/bin/lbx-init"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The Dockerfile templates `litterbox define` offers, as plain files: litterbox-assemble starts from these,
  # so it always matches the installed version.
  install -Dm644 -t "$pkgdir/usr/share/litterbox-sandbox/templates" litterbox/templates/*.Dockerfile
}
