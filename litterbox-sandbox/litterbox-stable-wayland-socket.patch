+/// Name of the Wayland socket as seen from inside every Litterbox. It is fixed
+/// so that the container does not depend on which `wayland-N` name the host
+/// compositor happened to pick when the Litterbox was built.
+pub const LBX_WAYLAND_DISPLAY: &str = "wayland-0";
+
+/// Stable host-side path that gets bind-mounted into the container as its
+/// Wayland socket.
+pub fn wayland_socket_link_path(lbx_name: &str) -> Result<PathBuf> {
+    Ok(env::xdg_runtime_dir()?
+        .join("litterbox")
+        .join(lbx_name)
+        .join(LBX_WAYLAND_DISPLAY))
+}
+
+/// Point the stable socket path at the compositor's current socket.
+///
+/// Podman resolves bind-mount sources when a container starts, so this must run
+/// before every `podman create`/`podman start`. That way the mount source always
+/// exists and refers to the live compositor, whatever `wayland-N` name it got.
+pub fn refresh_wayland_socket_link(lbx_name: &str) -> Result<PathBuf> {
+    let link = wayland_socket_link_path(lbx_name)?;
+
+    let display = env::wayland_display()
+        .context("WAYLAND_DISPLAY is not set. Run litterbox from inside your Wayland session.")?;
+    let display = Path::new(&display);
+    let target = if display.is_absolute() {
+        display.to_path_buf()
+    } else {
+        env::xdg_runtime_dir()?.join(display)
+    };
+    if !fs::exists(&target)? {
+        anyhow::bail!("Wayland socket {} does not exist", target.display());
+    }
+
+    let parent = link
+        .parent()
+        .expect("Wayland link path should have parent.");
+    fs::create_dir_all(parent).context("Failed to create Litterbox runtime directory")?;
+
+    // Create under a temporary name and rename over the old link so that two
+    // concurrent `enter`s cannot race each other.
+    let tmp = parent.join(format!(".{LBX_WAYLAND_DISPLAY}.{}", std::process::id()));
+    let _ = fs::remove_file(&tmp);
+    std::os::unix::fs::symlink(&target, &tmp)
+        .with_context(|| format!("Failed to create Wayland socket link {}", tmp.display()))?;
+    fs::rename(&tmp, &link).context("Failed to replace Wayland socket link")?;
+
+    log::debug!("Linked {} -> {}", link.display(), target.display());
+    Ok(link)
+}
+
 pub fn write_file(path: &Path, contents: &str) -> Result<()> {
     let output_dir = path.parent().expect("Path should have parent.");
     fs::create_dir_all(output_dir)?;
