# Maintainer: BoppOS Team
pkgname=litterbox-sandbox-addons
pkgver=0.1.0
pkgrel=1
pkgdesc="Host tools for Litterbox sandboxes: assemble definitions, install addons, export apps and terminals to the desktop, update packages inside a sandbox and prune old images, with shell completions, plus the boxed-run addon (keyring and D-Bus for IDEs)"
arch=('any')
url="https://github.com/bopp-os/pkgbuilds"
license=('GPL-3.0-or-later')
depends=('litterbox-sandbox' 'coreutils' 'findutils' 'gawk' 'grep' 'sed' 'tar')
optdepends=('xdg-utils: make exported apps the default handler for URL schemes (litterbox-export --url-handler)'
            'bash-completion: tab completion in bash')
source=(litterbox-addon
        litterbox-export
        litterbox-update
        litterbox-prune
        litterbox-assemble
        litterbox-tools.bash
        litterbox-tools.fish
        _litterbox-tools
        boxed-run
        boxed-run.packages.arch)
sha256sums=('3762b09865bfc4f721bac1bc3952a632506dd3027e1499da239c09a438d5fda8'
            '0021c33d8f7a8b18eb85039252cbab0a6140f6804f028a920227d25956b1dac1'
            'a34fcd2c0db333d14deab2b9fd3493b018c42da5def0084d7e11e93e21f7f1fd'
            '90b3fbc9a709ecc81e0f9789e227cd28cd57c2fce6c712bcc453e350ac551cf0'
            '2c633c2285014a8cd3572acfad54492c20c95d29b47925b1bf3616581ace4dff'
            '802f199c715cc50e1cec6d99e8642f111841937a9afe22ff4ff732496084a583'
            '15e109c0e0c7050a24fb3b8cc7d7120d443b4e3567f135ba5ffb37dfb5a1409d'
            '5671a69d84fa943838fb048304f72a7820b0b5a21126093c5691c5f32658262d'
            'f0e6eb1653ce29c9888818bba85b434f44c3b39654defd84393fcd994172780e'
            'aa453c43f699e488135b8eb798c0a0179515c1445d2e5611a3e5117a16bd10f2')

package() {
  local addons="$pkgdir/usr/share/litterbox-sandbox-addons"

  # Host side tools
  install -Dm755 litterbox-addon "$pkgdir/usr/bin/litterbox-addon"
  install -Dm755 litterbox-export "$pkgdir/usr/bin/litterbox-export"
  install -Dm755 litterbox-update "$pkgdir/usr/bin/litterbox-update"
  install -Dm755 litterbox-prune "$pkgdir/usr/bin/litterbox-prune"
  install -Dm755 litterbox-assemble "$pkgdir/usr/bin/litterbox-assemble"

  # Shell completions: one file per shell covers `litterbox` and every tool above. bash-completion and fish load
  # by command name, so the other names are symlinks to the same file.
  local share="$pkgdir/usr/share" t
  install -Dm644 litterbox-tools.bash "$share/bash-completion/completions/litterbox-addon"
  install -Dm644 litterbox-tools.fish "$share/fish/vendor_completions.d/litterbox-addon.fish"
  install -Dm644 _litterbox-tools "$share/zsh/site-functions/_litterbox-tools"
  for t in litterbox litterbox-export litterbox-update litterbox-prune litterbox-assemble; do
    ln -s litterbox-addon "$share/bash-completion/completions/$t"
    ln -s litterbox-addon.fish "$share/fish/vendor_completions.d/$t.fish"
  done

  # Each addon is a directory: executable files get baked into the image as
  # /usr/local/bin/<name>, packages.arch lists the packages they need.
  install -Dm755 boxed-run "$addons/boxed-run/boxed-run"
  install -Dm644 boxed-run.packages.arch "$addons/boxed-run/packages.arch"
}
